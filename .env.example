# Environment Variables for Binti Events Backend

# Server Port (Render automatically supplies PORT in production)
PORT=10000

# Node Environment (production / development)
NODE_ENV=production

# Allowed CORS Origin(s). Set to your deployed Vercel frontend URL or comma-separated list
CORS_ORIGIN=http://localhost:5173, https://q-frontend-weld.vercel.app

# Directory path for database storage (Optional; defaults to ./data or mounted Render disk e.g. /var/data)
DATA_DIR=/var/data

# Resend Email Configuration
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=Binti Events <onboarding@resend.dev>

# MongoDB Database Connection String (e.g. mongodb+srv://...)
MONGODB_URI=mongodb://localhost:27017/binti-events
