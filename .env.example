# Binti Events Backend - Environment Variables
# Copy this file to .env and configure all required variables

# ========== SERVER CONFIGURATION ==========
# Server Port (Render automatically assigns PORT in production)
PORT=3000

# Node Environment
NODE_ENV=production

# Frontend URL(s) for CORS. Use comma-separated list for multiple origins.
CORS_ORIGIN=https://q-frontend-weld.vercel.app

# ========== AUTHENTICATION (CRITICAL - DO NOT COMMIT TO VCS) ==========
# JWT Secret: Generate a 32+ character random string using: openssl rand -base64 32
JWT_SECRET=generate_a_32_byte_or_longer_random_secret_key_here

# Admin Account (Initial setup)
# Generate password using: openssl rand -base64 16
ADMIN_EMAIL=admin@bintievents.co.ke
ADMIN_PASSWORD=generate_a_long_unique_password_here
ADMIN_NAME=Administrator

# ========== DATABASE ==========
# Supabase PostgreSQL (production database)
# Get these from: https://app.supabase.com/project/[project-id]/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Data directory for local JSON storage (development only)
DATA_DIR=./data

# ========== EXTERNAL SERVICES ==========
# Google Gemini API Key
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Resend Email Service
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Binti Events <billing@bintievents.co.ke>
