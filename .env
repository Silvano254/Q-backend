# Server Port (Render automatically supplies PORT in production)
PORT=3000

# Node Environment
NODE_ENV=development

# Allowed CORS Origin(s). Use '*' for all origins, or specify your Vercel URL e.g. https://binti-events.vercel.app
CORS_ORIGIN=*

# Storage Directory Path (Optional: defaults to ./data)
DATA_DIR=./data

# Resend Email Configuration
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=Binti Events <onboarding@resend.dev>
