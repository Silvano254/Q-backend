# Server Port (Render automatically supplies PORT in production)
PORT=3000

# Node Environment
NODE_ENV=development

# Allowed CORS Origin(s). Use '*' for all origins, or specify your Vercel URL
CORS_ORIGIN=http://localhost:5173, https://q-frontend-weld.vercel.app

# Storage Directory Path (Optional: defaults to ./data)
DATA_DIR=./data

# Google Gemini API Key (Configured on Render in production for Binti AI processing)
GEMINI_API_KEY=

# Resend Email Configuration
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=Binti Events <onboarding@resend.dev>

# MongoDB Connection String (Will be overridden by Render environment variables in prod)
MONGODB_URI=mongodb://localhost:27017/binti-events
